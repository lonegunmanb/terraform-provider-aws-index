func (r *channelResource) flatten(ctx context.Context, out *kafka.DescribeChannelOutput, data *channelResourceModel) diag.Diagnostics {
	var diags diag.Diagnostics
	diags.Append(fwflex.Flatten(ctx, out, data)...)
	return diags
}
