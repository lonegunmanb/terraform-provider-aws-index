func newIPRouteResource(_ context.Context) (resource.ResourceWithConfigure, error) {
	r := &ipRouteResource{}

	r.SetDefaultCreateTimeout(30 * time.Minute)
	r.SetDefaultDeleteTimeout(30 * time.Minute)

	return r, nil
}
