func findBackupPolicyByID(ctx context.Context, conn *efs.Client, id string) (*awstypes.BackupPolicy, error) {
	input := efs.DescribeBackupPolicyInput{
		FileSystemId: aws.String(id),
	}
	return findBackupPolicy(ctx, conn, &input)
}
