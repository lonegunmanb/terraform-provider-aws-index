package github.com/hashicorp/terraform-provider-aws/internal/service/agentregistry
import (
	"context"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/service/agentregistrycontrol"
	smithyendpoints "github.com/aws/smithy-go/endpoints"
)
func newEndpointResolverV2() resolverV2 {
	return resolverV2{
		defaultResolver: agentregistrycontrol.NewDefaultEndpointResolverV2(),
	}
}
