package github.com/hashicorp/terraform-provider-aws/internal/service/pricingplanmanager
import (
	"context"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/service/pricingplanmanager"
	smithyendpoints "github.com/aws/smithy-go/endpoints"
)
func withBaseEndpoint(endpoint string) func(*pricingplanmanager.Options) {
	return func(o *pricingplanmanager.Options) {
		if endpoint != "" {
			o.BaseEndpoint = aws.String(endpoint)
		}
	}
}
