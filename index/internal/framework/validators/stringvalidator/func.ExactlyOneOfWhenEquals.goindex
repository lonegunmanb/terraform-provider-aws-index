package github.com/hashicorp/terraform-provider-aws/internal/framework/validators/stringvalidator
import (
	"github.com/hashicorp/terraform-plugin-framework/path"
	"github.com/hashicorp/terraform-plugin-framework/schema/validator"
	"github.com/hashicorp/terraform-provider-aws/internal/framework/validators/internal"
)
func ExactlyOneOfWhenEquals[T ~string](value T, expressions ...path.Expression) validator.String {
	return internal.ExactlyOneOfWhenValidator(whenEquals[T]{value: value}, expressions...)
}
