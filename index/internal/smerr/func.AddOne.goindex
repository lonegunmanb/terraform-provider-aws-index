)
func AddOne(ctx context.Context, existing *fwdiag.Diagnostics, incoming fwdiag.Diagnostic, keyvals ...any) {
	smarterr.AddOne(ctx, existing, incoming, injectContext(ctx, keyvals...)...)
}
