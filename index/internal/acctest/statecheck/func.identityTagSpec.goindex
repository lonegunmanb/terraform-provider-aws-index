func identityTagSpec(tagsSpec inttypes.ServicePackageResourceTags) tagSpecFinder {
	return func(ctx context.Context, sp conns.ServicePackage, typeName string) inttypes.ServicePackageResourceTags {
		return tagsSpec
	}
}
